# Search Console (required for SEO Agent v2)
GSC_PROPERTY=sc-domain:colixo.ch
GSC_SERVICE_ACCOUNT_JSON=

# Production site observed by the agent
SITE_BASE_URL=https://www.colixo.ch

# Optional later phase: AI-assisted content proposals only.
# Never commit a real key or token in this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
